<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="500.0" styleClass="wishlist-panel" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Controller_Wishlist_Panel">
    <stylesheets>
        <URL value="@../Styles/Wishlist_Panel.css" />
    </stylesheets>
    
    <VBox alignment="TOP_CENTER" spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header -->
        <HBox alignment="CENTER" spacing="10.0" styleClass="wishlist-header">
            <Label fx:id="wishlistTitleLabel" styleClass="wishlist-title" text="Wishlist (0)" />
            <Label fx:id="closeButton" onMouseClicked="#handleClose" styleClass="close-button" text="✕" />
        </HBox>
        
        <!-- Separator -->
        <Rectangle fill="#D3D3D3" height="1.0" width="480.0" />
        
        <!-- Items List -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="550.0" styleClass="wishlist-scroll">
            <content>
                <VBox fx:id="itemsContainer" alignment="TOP_CENTER" spacing="10.0" styleClass="wishlist-items-container">
                    <padding>
                        <javafx.geometry.Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        
        <!-- Empty State -->
        <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="10.0" styleClass="empty-state" visible="false">
            <Label styleClass="empty-state-label" text="Your wishlist is empty" />
        </VBox>
    </VBox>
</AnchorPane>
