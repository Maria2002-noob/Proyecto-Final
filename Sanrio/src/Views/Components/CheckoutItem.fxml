<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="120.0" prefWidth="480.0" styleClass="checkout-item" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Component_CheckoutItem">
    <stylesheets>
        <URL value="@../../Styles/Checkout_View.css" />
    </stylesheets>
    
    <HBox alignment="CENTER_LEFT" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        
        <!-- Product Image -->
        <ImageView fx:id="productImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" styleClass="checkout-item-image" />
        
        <!-- Product Details -->
        <VBox alignment="TOP_LEFT" prefHeight="100.0" prefWidth="250.0" spacing="5.0" HBox.hgrow="ALWAYS">
            <Label fx:id="productNameLabel" styleClass="checkout-item-name" text="Product Name" wrapText="true" />
            <Label fx:id="productPriceLabel" styleClass="checkout-item-price" text="\$0.00" />
        </VBox>
        
        <!-- Quantity -->
        <VBox alignment="CENTER" spacing="5.0">
            <Label styleClass="checkout-quantity-label" text="Cantidad" />
            <Label fx:id="quantityLabel" styleClass="checkout-quantity-value" text="1" />
        </VBox>
    </HBox>
</AnchorPane>
